# Copy this file to .env on the server (same folder) and fill in real values.
# NEVER commit the real .env — it's already in .gitignore.
# NEVER put any of these values in Netlify / website JS / anything that
# ships to the browser — they must stay server-only.

# HMAC secret used to sign short-lived PDF access tokens.
# Used by: get_pdf_token.php, proxy_pdf.php, secure_page_image.php
PDF_HMAC_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Shared secret the Android app signs requests with (X-PM-App-Ts /
# X-PM-App-Sign headers), proving a request genuinely came from the app
# and not a browser/curl spoofing the Origin header.
# See server/APP_ONLY_COURSES_SETUP.txt for what the app needs to send.
APP_SHARED_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET

# --- Database (used by db_connect.example.php) ---
# DB_HOST is "localhost" on virtually every Hostinger shared plan.
DB_HOST=localhost
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# --- Cashfree payment gateway (used by create_order.php) ---
# From the Cashfree dashboard. CASHFREE_ENV is PROD or TEST.
CASHFREE_APP_ID=CHANGE_ME
CASHFREE_SECRET_KEY=CHANGE_ME
CASHFREE_ENV=PROD
